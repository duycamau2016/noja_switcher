{
  "name": "nodeversions",
  "displayName": "Node & JDK Version Manager",
  "description": "Switch Node.js and JDK versions per VS Code workspace",
  "version": "1.4.2",
  "publisher": "yudaliot",
  "license": "ISC",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/duycamau2016/NodeVersions.git"
  },
  "bugs": {
    "url": "https://github.com/duycamau2016/NodeVersions/issues"
  },
  "homepage": "https://github.com/duycamau2016/NodeVersions#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "node",
    "nvm",
    "jdk",
    "java",
    "version manager",
    "port"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nodeversions.openPanel",
        "title": "Open Panel",
        "category": "NodeVersions",
        "icon": "$(window)"
      },
      {
        "command": "nodeversions.switchNode",
        "title": "Pin Node Version to Workspace",
        "category": "NodeVersions"
      },
      {
        "command": "nodeversions.switchJdk",
        "title": "Pin JDK Version to Workspace",
        "category": "NodeVersions"
      },
      {
        "command": "nodeversions.setGlobalNode",
        "title": "Set Global Default Node Version",
        "category": "NodeVersions"
      },
      {
        "command": "nodeversions.setGlobalJdk",
        "title": "Set Global Default JDK Version",
        "category": "NodeVersions"
      },
      {
        "command": "nodeversions.unpinWorkspace",
        "title": "Unpin Workspace (Use Global Defaults)",
        "category": "NodeVersions",
        "icon": "$(circle-slash)"
      },
      {
        "command": "nodeversions.listPorts",
        "title": "List Listening Ports",
        "category": "NodeVersions"
      },
      {
        "command": "nodeversions.refresh",
        "title": "Refresh Active Versions",
        "category": "NodeVersions"
      },
      {
        "command": "nodeversions.refreshViews",
        "title": "Refresh",
        "category": "NodeVersions",
        "icon": "$(refresh)"
      },
      {
        "command": "nodeversions.pinVersion",
        "title": "Pin to This Workspace",
        "category": "NodeVersions",
        "icon": "$(pin)"
      },
      {
        "command": "nodeversions.unpinVersion",
        "title": "Unpin (Use Global Default)",
        "category": "NodeVersions",
        "icon": "$(circle-slash)"
      },
      {
        "command": "nodeversions.setGlobalVersion",
        "title": "Set as Global Default",
        "category": "NodeVersions",
        "icon": "$(globe)"
      },
      {
        "command": "nodeversions.uninstallVersion",
        "title": "Uninstall",
        "category": "NodeVersions",
        "icon": "$(trash)"
      },
      {
        "command": "nodeversions.killPort",
        "title": "Kill Process",
        "category": "NodeVersions",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nodeversions.installVersion",
        "title": "Install This Version",
        "category": "NodeVersions",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nodeversions.refreshRemote",
        "title": "Reload Available Releases",
        "category": "NodeVersions",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nodeversions",
          "title": "Node & JDK",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "nodeversions": [
        {
          "id": "nodeversions.versions",
          "name": "Versions"
        },
        {
          "id": "nodeversions.install",
          "name": "Install New"
        },
        {
          "id": "nodeversions.ports",
          "name": "Listening Ports"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "nodeversions.pinVersion",
          "when": "false"
        },
        {
          "command": "nodeversions.unpinVersion",
          "when": "false"
        },
        {
          "command": "nodeversions.setGlobalVersion",
          "when": "false"
        },
        {
          "command": "nodeversions.uninstallVersion",
          "when": "false"
        },
        {
          "command": "nodeversions.killPort",
          "when": "false"
        },
        {
          "command": "nodeversions.installVersion",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "nodeversions.openPanel",
          "when": "view == nodeversions.versions",
          "group": "navigation@1"
        },
        {
          "command": "nodeversions.unpinWorkspace",
          "when": "view == nodeversions.versions",
          "group": "1_pins@1"
        },
        {
          "command": "nodeversions.refreshViews",
          "when": "view == nodeversions.versions || view == nodeversions.ports",
          "group": "navigation@2"
        },
        {
          "command": "nodeversions.refreshRemote",
          "when": "view == nodeversions.install",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nodeversions.pinVersion",
          "when": "view == nodeversions.versions && viewItem =~ /^nvmVersion-inactive/",
          "group": "inline@1"
        },
        {
          "command": "nodeversions.unpinVersion",
          "when": "view == nodeversions.versions && viewItem =~ /^nvmTool-.*-pinned$/",
          "group": "inline@1"
        },
        {
          "command": "nodeversions.pinVersion",
          "when": "view == nodeversions.versions && viewItem =~ /^nvmVersion-active/",
          "group": "1_switch@1"
        },
        {
          "command": "nodeversions.setGlobalVersion",
          "when": "view == nodeversions.versions && viewItem =~ /^nvmVersion-/",
          "group": "1_switch@2"
        },
        {
          "command": "nodeversions.uninstallVersion",
          "when": "view == nodeversions.versions && viewItem =~ /removable$/",
          "group": "inline@2"
        },
        {
          "command": "nodeversions.installVersion",
          "when": "view == nodeversions.install && viewItem == nvmRemote",
          "group": "inline"
        },
        {
          "command": "nodeversions.killPort",
          "when": "view == nodeversions.ports && viewItem == nvmPort",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Node & JDK Version Manager",
      "properties": {
        "nodeversions.autoUpdateTerminalEnv": {
          "type": "boolean",
          "default": true,
          "description": "Prepend the active Node/JDK to PATH (and set JAVA_HOME) for newly opened integrated terminals. Existing terminals are not affected. This is what makes a workspace pin take effect — turning it off leaves every terminal on the global default."
        },
        "nodeversions.relaunchTerminalsOnChange": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Offer to relaunch open terminals after the version changes.",
            "Relaunch open terminals automatically.",
            "Leave open terminals alone; only new ones get the new version."
          ],
          "default": "ask",
          "markdownDescription": "A shell cannot have its `PATH` changed once it is running, so an open terminal keeps the old version until it is relaunched. Relaunching stops anything running in that terminal. VS Code already relaunches terminals you have not typed in — see `#terminal.integrated.environmentChangesRelaunch#`."
        },
        "nodeversions.useVersionFiles": {
          "type": "boolean",
          "default": true,
          "description": "Pin the version declared by a .nvmrc / .node-version / .java-version file in the workspace root. A pin set through the UI overrides the file."
        },
        "nodeversions.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active Node/JDK version in the status bar."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "typecheck:webview": "tsc -p tsconfig.webview.json --noEmit",
    "package": "node build.js && vsce package --no-dependencies",
    "publish": "node build.js && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}
